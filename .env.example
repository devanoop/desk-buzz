# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection string. Provided automatically by Railway/Render/Fly's
# managed Postgres add-on when you provision one; for local development,
# point it at the Postgres started by `docker compose up` (see README) or
# your own local instance.
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=postgres://deskbuz:deskbuz@localhost:5432/deskbuz

# Required. Long random secret used to sign CSRF tokens (HMAC). The app
# refuses to start without it. Generate with:
#   openssl rand -hex 32
CSRF_SECRET=

# Optional. "production" makes the session cookie Secure-only (HTTPS
# required) — leave unset for local http:// development. The Docker image
# sets this for you; you shouldn't need to set it by hand except locally
# when testing over HTTPS.
# NODE_ENV=production

# Optional. Port the Node server listens on. Railway/Render/Fly inject this
# automatically — you normally don't need to set it yourself.
# PORT=3000

# Optional. Host/interface to bind to. Leave unset to bind all interfaces
# (required for the app to be reachable inside a container).
# HOST=
